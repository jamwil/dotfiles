{
  "permission": {
    "*": "ask",
    "path": {
      "*.env*": "deny",
      "*.ssh/*": "deny"
    },
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "fd *": "allow",
      "find *": "allow",
      "sort *": "allow",
      "head *": "allow",
      "cat *": "allow",
      "echo *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git status *": "allow",
      "git ls-files *": "allow",
      "printf *": "allow",
      "uv run ruff *": "allow",
      "ruff *": "allow",
      "true": "allow"
    },
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "external_directory": "ask"
  }
}
